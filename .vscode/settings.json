{
	// Scoped per language: a top-level `editor.defaultFormatter`
	// would hand biome files it does not own, like Python.
	"editor.formatOnSave": true,

	"[json]": { "editor.defaultFormatter": "biomejs.biome" },
	"[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
	"[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
	"[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
	"[css]": { "editor.defaultFormatter": "biomejs.biome" },
	"[html]": { "editor.defaultFormatter": "biomejs.biome" },

	// Svelte files stay with the Svelte extension — biome's support for them
	// is limited to embedded snippets.
	"[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" },

	"[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },

	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit"
	}
}